# Shared local development settings
COMPOSE_PROJECT_NAME=nexusops

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me
NEXUSOPS_MASTER_KEY=
NEXUSOPS_ADMIN_USER=admin
NEXUSOPS_ADMIN_EMAIL=admin@example.com
NEXUSOPS_ADMIN_PASSWORD=change-this-local-password
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=postgresql+asyncpg://nexusops:nexusops@postgres:5432/nexusops

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=nexusops
POSTGRES_USER=nexusops
POSTGRES_PASSWORD=nexusops

# Optional MariaDB alternative
MARIADB_DATABASE=nexusops
MARIADB_USER=nexusops
MARIADB_PASSWORD=nexusops
MARIADB_ROOT_PASSWORD=nexusops-root

# Proxmox
PROXMOX_API_URL=https://proxmox.example.local:8006/api2/json
PROXMOX_VERIFY_SSL=false
PROXMOX_TOKEN_ID=root@pam!nexusops
PROXMOX_TOKEN_SECRET=
PROXMOX_TIMEOUT_SECONDS=15

# SSH
SSH_DEFAULT_PORT=22
SSH_CONNECT_TIMEOUT_SECONDS=15
SSH_COMMAND_TIMEOUT_SECONDS=60
SSH_PRIVATE_KEY_PATH=

# Monitoring
PROMETHEUS_API_URL=
GRAFANA_BASE_URL=
LOKI_BASE_URL=
MONITORING_TIMEOUT_SECONDS=10

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
