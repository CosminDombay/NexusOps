# Shared local development settings
COMPOSE_PROJECT_NAME=nexusops

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=human
SECRET_KEY=change-me
NEXUSOPS_MASTER_KEY=
NEXUSOPS_ADMIN_USER=admin
NEXUSOPS_ADMIN_EMAIL=admin@example.com
NEXUSOPS_ADMIN_PASSWORD=change-this-local-password
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=postgresql+asyncpg://nexusops:nexusops@postgres:5432/nexusops
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_INACTIVITY_TIMEOUT_MINUTES=480
ENABLE_OPENAPI=true
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=10
WEBSOCKET_RATE_LIMIT_PER_MINUTE=30
REMOTE_ACCESS_TOKEN_EXPIRE_SECONDS=45
TRUSTED_PROXY_HOPS=0

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=nexusops
POSTGRES_USER=nexusops
POSTGRES_PASSWORD=nexusops

# Optional MariaDB alternative
MARIADB_DATABASE=nexusops
MARIADB_USER=nexusops
MARIADB_PASSWORD=nexusops
MARIADB_ROOT_PASSWORD=nexusops-root

# Proxmox
PROXMOX_API_URL=https://proxmox.example.local:8006/api2/json
PROXMOX_VERIFY_SSL=false
PROXMOX_TOKEN_ID=root@pam!nexusops
PROXMOX_TOKEN_SECRET=
PROXMOX_TIMEOUT_SECONDS=15

# SSH
SSH_DEFAULT_PORT=22
SSH_CONNECT_TIMEOUT_SECONDS=15
SSH_COMMAND_TIMEOUT_SECONDS=60
SSH_PRIVATE_KEY_PATH=
SSH_TRUST_ON_FIRST_USE=true

# Monitoring
PROMETHEUS_API_URL=
GRAFANA_BASE_URL=
LOKI_BASE_URL=
MONITORING_TIMEOUT_SECONDS=10
MONITORING_VALIDATION_INTERVAL_SECONDS=300
RUNTIME_REFRESH_ENABLED=true
RUNTIME_REFRESH_INTERVAL_SECONDS=60
RUNTIME_REFRESH_MIN_INTERVAL_SECONDS=30
RUNTIME_REFRESH_CONCURRENCY=4
RUNTIME_REFRESH_TIMEOUT_SECONDS=45

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
