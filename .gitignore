!.env.production.example
!backend/.env.example
!frontend/.env.example

# Editors, IDEs and local agent context
.idea/
.vscode/
.obsidian/
.agents/
.codex/
.claude/

# OS
Thumbs.db
.DS_Store

# Local agent working memory (kept out of the published repo)
