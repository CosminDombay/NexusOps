ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change-me
NEXUSOPS_MASTER_KEY=
NEXUSOPS_ADMIN_USER=admin
NEXUSOPS_ADMIN_EMAIL=admin@example.com
NEXUSOPS_ADMIN_PASSWORD=change-this-local-password
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=postgresql+asyncpg://nexusops:nexusops@localhost:5432/nexusops
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_INACTIVITY_TIMEOUT_MINUTES=480
ENABLE_OPENAPI=true
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=10
WEBSOCKET_RATE_LIMIT_PER_MINUTE=30
REMOTE_ACCESS_TOKEN_EXPIRE_SECONDS=45
ALLOW_INSECURE_DEV_SECRETS=true
ALLOW_INSECURE_DEV_TLS=true
PROXMOX_API_URL=https://proxmox.example.local:8006/api2/json
PROXMOX_VERIFY_SSL=false
PROXMOX_TOKEN_ID=root@pam!nexusops
PROXMOX_TOKEN_SECRET=
PROXMOX_TIMEOUT_SECONDS=15
SSH_DEFAULT_PORT=22
SSH_CONNECT_TIMEOUT_SECONDS=15
SSH_COMMAND_TIMEOUT_SECONDS=60
SSH_PRIVATE_KEY_PATH=
SSH_TRUST_ON_FIRST_USE=true
PROMETHEUS_API_URL=
GRAFANA_BASE_URL=
LOKI_BASE_URL=
MONITORING_TIMEOUT_SECONDS=10
