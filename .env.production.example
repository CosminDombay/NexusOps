# NexusOps production environment template.
# Copy to .env on the production host and replace every CHANGE_ME value before starting the stack.

COMPOSE_PROJECT_NAME=nexusops

# Published ports on the production host. The frontend nginx container proxies /api/v1 to backend.
BACKEND_PORT=127.0.0.1:8000
FRONTEND_PORT=80

# Runtime mode.
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=human
ENABLE_OPENAPI=false
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=10
WEBSOCKET_RATE_LIMIT_PER_MINUTE=30
REMOTE_ACCESS_TOKEN_EXPIRE_SECONDS=45
TRUSTED_PROXY_HOPS=1

# Security.
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
NEXUSOPS_MASTER_KEY=CHANGE_ME_FERNET_KEY
NEXUSOPS_ADMIN_USER=admin
NEXUSOPS_ADMIN_EMAIL=admin@example.com
NEXUSOPS_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_INACTIVITY_TIMEOUT_MINUTES=480

# API / browser access.
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["https://nexusops.example.com"]
VITE_API_BASE_URL=/api/v1

# PostgreSQL container.
POSTGRES_DB=nexusops
POSTGRES_USER=nexusops
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Optional infrastructure integrations can also be configured later from the UI.
PROXMOX_API_URL=
PROXMOX_VERIFY_SSL=true
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_TIMEOUT_SECONDS=15

# SSH defaults.
SSH_DEFAULT_PORT=22
SSH_CONNECT_TIMEOUT_SECONDS=15
SSH_COMMAND_TIMEOUT_SECONDS=60
SSH_PRIVATE_KEY_PATH=
SSH_TRUST_ON_FIRST_USE=true

# Monitoring/runtime refresh.
PROMETHEUS_API_URL=
GRAFANA_BASE_URL=
LOKI_BASE_URL=
MONITORING_TIMEOUT_SECONDS=10
MONITORING_VALIDATION_INTERVAL_SECONDS=300
RUNTIME_REFRESH_ENABLED=true
RUNTIME_REFRESH_INTERVAL_SECONDS=60
RUNTIME_REFRESH_MIN_INTERVAL_SECONDS=30
RUNTIME_REFRESH_CONCURRENCY=4
RUNTIME_REFRESH_TIMEOUT_SECONDS=45
